# ========================================================
# EcoTwin Smart Waste Management Digital Twin - Environment Config
# ========================================================

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional: Direct PostgreSQL Connection URI (Session/Transaction Pooler)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Flask Server Configuration
PORT=5000
SECRET_KEY=replace-with-a-random-secret-before-deployment

# Model & Decision Thresholds
CONFIDENCE_THRESHOLD=0.65
MODEL_VERSION=mobilenetv2-v1.0
